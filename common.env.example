# Copy this file to common.env for machine-local overrides.
LOG_LEVEL=INFO
MOUSE_MOVER_DELAY=1.0
MOUSE_MOVER_OFFSET=20
MOUSE_MOVER_DURATION=0.4
STOP_HOTKEY=ctrl+option+s
RANDOM_AREA_WIDTH=800
RANDOM_AREA_HEIGHT=600
MANUAL_MOVE_THRESHOLD=60
MANUAL_IDLE_SECONDS=3

# Shared Synology/CloudStation roots used by the common project convention.
CLOUDSTATION_ROOT_WINDOWS=D:\CloudStation
CLOUDSTATION_ROOT_MACOS=~/SynologyDrive
CLOUDSTATION_ROOT_LINUX=~/CloudStation
